#!/usr/bin/make -f

## Copyright (C) 2012 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

#export DH_VERBOSE=1

%:
	dh $@

## tb-updater-dispvm.service does a one-time, pre-session mount setup; dpkg must
## NOT start or restart it during a live user session, which would open a root
## 'mount --bind' check-to-use race (CWE-59). '--no-start' keeps it ENABLED
## (started at boot, before any user/qrexec process) with no dpkg session-time
## (re)start. Each unit is handled explicitly (this debhelper has no
## '--remaining-units'); a new unit must be added here.
override_dh_installsystemd:
	dh_installsystemd --no-start tb-updater-dispvm.service
	dh_installsystemd tb-updater-first-boot.service

override_dh_installman:
	dh_installman $(CURDIR)/auto-generated-man-pages/*

override_dh_installchangelogs:
	dh_installchangelogs changelog.upstream upstream
