# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/check_runtime.bsh || true
if ! declare -F was_executed >/dev/null; then
   printf '%s\n' "$0: ERROR: cannot source check_runtime.bsh!" >&2
   exit 1
fi

## Executed: strict mode BEFORE the helper sources, so a missing helper aborts
## the oneshot instead of failing open to 'exit 0' without the bind mounts.
## Sourced (tests): none of it, so the caller's shell options stay intact.
if was_executed "${BASH_SOURCE[0]}"; then
   set -x
   set -o errexit
   set -o nounset
   set -o errtrace
   set -o pipefail
   shopt -s inherit_errexit
   shopt -s shift_verbose
   export LC_ALL=C
fi

# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/strings.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/strings.bsh
# shellcheck source=../../../../helper-scripts/usr/libexec/helper-scripts/has.bsh
source "${HELPER_SCRIPTS_PATH:-}"/usr/libexec/helper-scripts/has.bsh

## Plain globals, not environment-derived: a test that sources this script
## points them at a scratch tree before calling main.
home_base_dir="/home"
tb_binary_cache_dir="/var/cache/tb-binary"
## Qubes private-volume home; its bind copies are remounted nosuid,nodev below.
rw_home_base_dir="/rw/home"

main() {
   ## The account "user" fallback is intentional.
   ## The sysmaint session is not supposed to run Tor Browser.
   user_name="user"

   if ischroot --default-false ; then
      exit 0
   fi

   if has qubesdb-read ; then
      qubes_vm_name="$(qubesdb-read /name)"
      qubes_vm_persistence="$(qubesdb-read /qubes-vm-persistence)"
      if ! user_name=$(qubesdb-read /default-user) ; then
         printf '%s\n' "$0: WARNING: failed to run 'qubesdb-read /default-user', falling back to user_name=user"
         user_name=user
      fi
      ## qubesdb is trusted in the Qubes model but the returned value is
      ## about to be pasted into mkdir/chown/mount path arguments. Reject
      ## anything that is not a plain POSIX-style account name so a stray
      ## value cannot traverse out of /home or create mount points at
      ## attacker-chosen locations.
      if ! check_valid_linux_user_account_name "${user_name}"; then
         printf '%s\n' "$0: WARNING: qubesdb '/default-user' returned unsafe value '${user_name}', falling back to user_name=user"
         user_name=user
      fi
   else
      ## Do not do any of this outside of Qubes.
      exit 0
   fi

   ## Avoid running in Qubes DVM Template.
   ## https://forums.whonix.org/t/if-tb-updater-storage-path-for-qubes-r4-dispvms/18684
   if printf '%s\n' "${qubes_vm_name}" | grep -- "-dvm" >/dev/null 2>/dev/null ; then
      exit 0
   fi

   if test -f /run/qubes/this-is-templatevm ; then
      exit 0
   fi

   ## Do this only in a DispVM.
   if [ ! "${qubes_vm_persistence}" = "none" ]; then
      exit 0
   fi

   if [ ! -d "${home_base_dir}/${user_name}" ]; then
      exit 0
   fi

   if [ ! -d "${tb_binary_cache_dir}" ]; then
      exit 0
   fi

   touch -- /run/tb-updater-dispvm.done

   ## Refuse a symlink at any bind source, bind target, or remount path before
   ## the mkdir/chown/mount below. These are check-to-use pairs, but there is no
   ## TOCTOU window: the service runs exactly ONCE per boot, at early boot before
   ## any user/qrexec process exists to race the check -- debian/rules pins
   ## 'dh_installsystemd --no-start' (dpkg never restarts it) and the unit sets
   ## 'ConditionPathExists=!/run/tb-updater-dispvm.done' (a manual restart
   ## no-ops). See tb-updater-dispvm.service and debian/rules.
   ## Covers both sides and the /rw copies: 'chown --recursive' below makes the
   ## cache user-owned, a DispVM home/cache is a DVM-Template clone, and the
   ## /rw/home remount targets are user-writable -- so a symlink could be
   ## pre-planted at any of these. '[ -L ]' checks the final component only;
   ## listing each intermediate (.cache) covers an intermediate symlink too,
   ## which --no-canonicalize on the bind does not.
   for tb_mount_point in \
      "${home_base_dir}/${user_name}/.tb" \
      "${home_base_dir}/${user_name}/.cache" \
      "${home_base_dir}/${user_name}/.cache/tb" \
      "${tb_binary_cache_dir}/.tb" \
      "${tb_binary_cache_dir}/.cache" \
      "${tb_binary_cache_dir}/.cache/tb" \
      "${rw_home_base_dir}/${user_name}/.tb" \
      "${rw_home_base_dir}/${user_name}/.cache" \
      "${rw_home_base_dir}/${user_name}/.cache/tb" ; do
      if [ -L "${tb_mount_point}" ]; then
         printf '%s\n' "$0: ERROR: refusing unexpected symlink at '${tb_mount_point}'!" >&2
         exit 1
      fi
   done

   ## There is no way to prevent chown from dereferencing symlinks that occur
   ## anywhere other than the last path component. --no-dereference is defense
   ## in depth but not entirely safe, we rely on the symlink check above for
   ## safety here.
   mkdir --parents -- "${home_base_dir}/${user_name}/.tb" "${home_base_dir}/${user_name}/.cache/tb"
   ## style-ok: lpe-symlink-follow,lpe-root-write-user-path -- boot-only,
   ## pre-session (see symlink guard above).
   chown --no-dereference -- "${user_name}:${user_name}" "${home_base_dir}/${user_name}/.tb"
   ## style-ok: lpe-symlink-follow,lpe-root-write-user-path -- boot-only,
   ## pre-session (see symlink guard above).
   chown --no-dereference -- "${user_name}:${user_name}" "${home_base_dir}/${user_name}/.cache"
   ## style-ok: lpe-symlink-follow,lpe-root-write-user-path -- boot-only,
   ## pre-session (see symlink guard above).
   chown --no-dereference -- "${user_name}:${user_name}" "${home_base_dir}/${user_name}/.cache/tb"

   ## style-ok: lpe-symlink-follow,lpe-home-recursive-write -- root-owned
   ## /var/cache path, not under /home; recursive chown does not follow symlinks.
   chown --recursive --no-dereference -- "${user_name}:${user_name}" "${tb_binary_cache_dir}"

   ## Bind the persistent cache onto the user's home. --no-canonicalize makes
   ## mount refuse a symlinked final mountpoint component at the mount layer
   ## regardless of timing; it does NOT guard the bind source or an intermediate
   ## path component, which the symlink guard above covers (it checks every
   ## source and target path, each component).
   if [ -d "${tb_binary_cache_dir}/.tb" ]; then
      mount --no-canonicalize --bind -o nosuid,nodev -- "${tb_binary_cache_dir}/.tb" "${home_base_dir}/${user_name}/.tb"
   fi
   if [ -d "${tb_binary_cache_dir}/.cache/tb" ]; then
      mount --no-canonicalize --bind -o nosuid,nodev -- "${tb_binary_cache_dir}/.cache/tb" "${home_base_dir}/${user_name}/.cache/tb"
   fi

   ## results in:
   # mount | grep -- home
   # /dev/xvdb on /home type ext4 (rw,nosuid,nodev,noexec,relatime,discard)
   # /dev/xvda3 on /home/user/.tb type ext4 (rw,nosuid,nodev,noatime,discard)
   # /dev/xvda3 on /rw/home/user/.tb type ext4 (rw,noatime,discard)
   # /dev/xvda3 on /home/user/.cache/tb type ext4 (rw,nosuid,nodev,noatime,discard)
   # /dev/xvda3 on /rw/home/user/.cache/tb type ext4 (rw,noatime,discard)

   ## Remount the Qubes-persistent copies with nosuid,nodev. --no-canonicalize
   ## for consistency with the binds above (accepted and harmless on remount); a
   ## symlinked /rw/home path is already rejected by the guard above.
   if [ -d "${rw_home_base_dir}/${user_name}/.tb" ]; then
      mount --no-canonicalize -o remount,nosuid,nodev -- "${rw_home_base_dir}/${user_name}/.tb"
   fi
   if [ -d "${rw_home_base_dir}/${user_name}/.cache/tb" ]; then
      mount --no-canonicalize -o remount,nosuid,nodev -- "${rw_home_base_dir}/${user_name}/.cache/tb"
   fi

   ## results in:
   # mount | grep -- home
   # /dev/xvdb on /home type ext4 (rw,nosuid,nodev,noexec,relatime,discard)
   # /dev/xvda3 on /home/user/.tb type ext4 (rw,nosuid,nodev,noatime,discard)
   # /dev/xvda3 on /rw/home/user/.tb type ext4 (rw,nosuid,nodev,noatime,discard)
   # /dev/xvda3 on /home/user/.cache/tb type ext4 (rw,nosuid,nodev,noatime,discard)
   # /dev/xvda3 on /rw/home/user/.cache/tb type ext4 (rw,nosuid,nodev,noatime,discard)
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
