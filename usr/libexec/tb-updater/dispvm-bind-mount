## TOCTOU-safe bind mount for tb-updater's Qubes DispVM setup.
##
## Usage: dispvm-bind-mount SOURCE TARGET
##
## Bind-mounts SOURCE onto TARGET with nosuid,nodev. BOTH paths are resolved one
## component at a time with O_NOFOLLOW, so a symlink anywhere in either path is
## refused rather than followed. The mount is then done entirely against the
## pinned file descriptors via the mount API (open_tree -> mount_setattr ->
## move_mount): nosuid,nodev is set on the detached clone BEFORE it is attached,
## and attachment targets the pinned TARGET fd. Nothing is re-resolved by path
## name, so a concurrent rename/symlink swap cannot redirect root into following
## a symlink nor leave a half-configured mount -- the check-to-use (TOCTOU) race
## a plain 'mount --bind <path>' is subject to. Run as root.

import ctypes
import os
import stat
import sys

## open_tree(2) / move_mount(2) / mount_setattr(2) flags and attributes.
OPEN_TREE_CLONE = 0x1
AT_EMPTY_PATH = 0x1000
## Empty from-path (0x4) and empty to-path (0x40): both sides are fds.
MOVE_MOUNT_F_EMPTY_PATH = 0x4
MOVE_MOUNT_T_EMPTY_PATH = 0x40
MOUNT_ATTR_NOSUID = 0x2
MOUNT_ATTR_NODEV = 0x4


class MountAttr(ctypes.Structure):
    """struct mount_attr for mount_setattr(2)."""
    _fields_ = (
        ("attr_set", ctypes.c_uint64),
        ("attr_clr", ctypes.c_uint64),
        ("propagation", ctypes.c_uint64),
        ("userns_fd", ctypes.c_uint64),
    )


def die(message):
    print(f"{os.path.basename(sys.argv[0])}: ERROR: {message}", file=sys.stderr)
    sys.exit(1)


def open_nofollow_directory(path):
    """Return an O_PATH|O_CLOEXEC directory fd for the absolute PATH, opening
    every component with O_NOFOLLOW and rejecting any component that is a symlink
    or not a directory. O_PATH needs only search (+x) permission -- not read --
    and fstat on the resulting fd gives an unambiguous type check (O_DIRECTORY
    with O_PATH|O_NOFOLLOW does not reliably fail on a symlink). The caller owns
    and closes the fd."""
    if not path.startswith("/"):
        die(f"path is not absolute: {path!r}")
    flags = os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC
    ## '/' is never a symlink; walk from it one component at a time.
    dir_fd = os.open("/", os.O_PATH | os.O_CLOEXEC)
    try:
        for component in path.strip("/").split("/"):
            if component in ("", ".", ".."):
                die(f"unsafe path component in {path!r}")
            next_fd = os.open(component, flags, dir_fd=dir_fd)
            os.close(dir_fd)
            dir_fd = next_fd
            mode = os.fstat(dir_fd).st_mode
            if stat.S_ISLNK(mode):
                die(f"refusing symlink component in {path!r}")
            if not stat.S_ISDIR(mode):
                die(f"refusing non-directory component in {path!r}")
    except OSError as exc:
        os.close(dir_fd)
        die(f"refusing to resolve {path!r}: {exc.strerror}")
    return dir_fd


def check(libc, result, call):
    if result == -1:
        die(f"{call} failed: {os.strerror(ctypes.get_errno())}")
    return result


def main():
    if len(sys.argv) != 3:
        die("usage: dispvm-bind-mount SOURCE TARGET")
    source, target = sys.argv[1], sys.argv[2]

    libc = ctypes.CDLL("libc.so.6", use_errno=True)
    libc.open_tree.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    libc.open_tree.restype = ctypes.c_int
    libc.mount_setattr.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint,
                                   ctypes.c_void_p, ctypes.c_size_t)
    libc.mount_setattr.restype = ctypes.c_int
    libc.move_mount.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int,
                                ctypes.c_char_p, ctypes.c_uint)
    libc.move_mount.restype = ctypes.c_int

    source_fd = open_nofollow_directory(source)
    target_fd = open_nofollow_directory(target)

    ## Clone the pinned SOURCE directory into a detached mount tree.
    tree_fd = check(libc, libc.open_tree(
        source_fd, b"", OPEN_TREE_CLONE | AT_EMPTY_PATH | os.O_CLOEXEC),
        "open_tree")
    os.close(source_fd)

    ## Set nosuid,nodev on the detached tree BEFORE attaching it (atomic: there
    ## is no window in which the mount exists without the flags).
    attr = MountAttr(attr_set=MOUNT_ATTR_NOSUID | MOUNT_ATTR_NODEV)
    check(libc, libc.mount_setattr(
        tree_fd, b"", AT_EMPTY_PATH, ctypes.byref(attr), ctypes.sizeof(attr)),
        "mount_setattr")

    ## Attach the configured tree onto the pinned TARGET fd (no path re-walk).
    check(libc, libc.move_mount(
        tree_fd, b"", target_fd, b"",
        MOVE_MOUNT_F_EMPTY_PATH | MOVE_MOUNT_T_EMPTY_PATH),
        "move_mount")
    os.close(tree_fd)
    os.close(target_fd)


if __name__ == "__main__":
    main()
